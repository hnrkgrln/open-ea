model Application {
  id            String        @id @default(uuid())
  name          String
  description   String?
  owner         String?
  ownerOrgId    String?
  lifecycle     String?       @default("Discovery")
  lifecycleStartDate DateTime?
  lifecycleEndDate   DateTime?
  contractStartDate  DateTime?
  contractEndDate    DateTime?
  contractDetails    String?
  vendorName    String?
  vendorUrl     String?
  vendorSummary String?
  type          String?
  criticality   String?       @default("3")
  cost          String?       @default("1")
  functionalFit String?       @default("3")
  technicalFit  String?       @default("3")
  timeRationale String?
  metadata      String?
  references    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  // User id of the account that created or last changed this record. No foreign key.
  // A removed account is left out of the audit trail.
  createdById   String?
  updatedById   String?
  ownerOrg      Organization? @relation("OrgOwnedApps", fields: [ownerOrgId], references: [id], onDelete: SetNull)
  capabilities  Capability[]  @relation("ApplicationToCapability")
  sourceOf      Integration[] @relation("sourceApp")
  targetOf      Integration[] @relation("targetApp")
  ownedInformationObjects InformationObject[] @relation("AppOwner")
  processedInformationObjects InformationObject[] @relation("AppProcessesInfoObject")
  stateId String @default("current")
  state   LandscapeState @relation(fields: [stateId], references: [id], onDelete: Restrict)

  @@index([stateId])
}

model Capability {
  id           String        @id @default(uuid())
  name         String
  description  String?
  criticality  String?       @default("3")
  metadata     String?
  references   String?
  parentId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdById  String?
  updatedById  String?
  parent       Capability?   @relation("CapabilityToCapability", fields: [parentId], references: [id], onDelete: Cascade)
  children     Capability[]  @relation("CapabilityToCapability")
  applications Application[] @relation("ApplicationToCapability")
  supportingOrganizations Organization[] @relation("OrgSupportsCapability")
  strategicGoals StrategicGoal[] @relation("GoalRequiresCapability")
  stateId String @default("current")
  state   LandscapeState @relation(fields: [stateId], references: [id], onDelete: Restrict)

  @@index([stateId])
}

model StrategicGoal {
  id           String          @id @default(uuid())
  name         String
  description  String?
  references   String?
  parentId     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  createdById  String?
  updatedById  String?
  parent       StrategicGoal?  @relation("GoalToGoal", fields: [parentId], references: [id], onDelete: Cascade)
  children     StrategicGoal[] @relation("GoalToGoal")
  capabilities Capability[]    @relation("GoalRequiresCapability")
  stateId String @default("current")
  state   LandscapeState @relation(fields: [stateId], references: [id], onDelete: Restrict)

  @@index([stateId])
}

model Organization {
  id                String              @id @default(uuid())
  name              String
  description       String?
  type              String?
  parentId          String?
  references        String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  createdById       String?
  updatedById       String?
  parent            Organization?       @relation("OrgToOrg", fields: [parentId], references: [id], onDelete: Cascade)
  children          Organization[]      @relation("OrgToOrg")
  informationObjects InformationObject[]
  ownedApplications Application[]       @relation("OrgOwnedApps")
  supportedCapabilities Capability[]    @relation("OrgSupportsCapability")
  stateId String @default("current")
  state   LandscapeState @relation(fields: [stateId], references: [id], onDelete: Restrict)

  @@index([stateId])
}

model InformationObject {
  id              String        @id @default(uuid())
  name            String
  aliases         String?
  description     String?
  confidentiality String?       @default("1")
  integrity       String?       @default("1")
  availability    String?       @default("1")
  piiCategory     String?       @default("1")
  type            String?
  metadata        String?
  references      String?
  businessOwnerId String?
  appOwnerId      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdById     String?
  updatedById     String?
  businessOwner   Organization? @relation(fields: [businessOwnerId], references: [id], onDelete: SetNull)
  appOwner        Application?  @relation("AppOwner", fields: [appOwnerId], references: [id], onDelete: SetNull)
  integrations    Integration[]
  processingApplications Application[] @relation("AppProcessesInfoObject")
  stateId String @default("current")
  state   LandscapeState @relation(fields: [stateId], references: [id], onDelete: Restrict)

  @@index([stateId])
}

model Integration {
  id            String             @id @default(uuid())
  name          String?
  description   String?
  sourceAppId   String
  targetAppId   String
  infoObjectId  String?
  pattern       String?
  type          String?
  frequency     String?
  crud          String?
  references    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  createdById   String?
  updatedById   String?
  targetApp     Application        @relation("targetApp", fields: [targetAppId], references: [id], onDelete: Cascade)
  sourceApp     Application        @relation("sourceApp", fields: [sourceAppId], references: [id], onDelete: Cascade)
  payload       InformationObject? @relation(fields: [infoObjectId], references: [id], onDelete: SetNull)
  stateId String @default("current")
  state   LandscapeState @relation(fields: [stateId], references: [id], onDelete: Restrict)

  @@index([stateId])
}

model MetadataDefinition {
  id         String   @id @default(uuid())
  entityType String
  fieldName  String
  fieldType  String
  label       String
  description String?
  required    Boolean  @default(false)
  min        Int?     @default(0)
  max        Int?     @default(100)
  scaleType  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Picklist {
  id      String           @id @default(uuid())
  name    String           @unique
  label   String
  options PicklistOption[]
}

model PicklistOption {
  id         String   @id @default(uuid())
  value      String
  label      String
  description String?
  color      String?
  order      Int      @default(0)
  picklistId String
  picklist   Picklist @relation(fields: [picklistId], references: [id], onDelete: Cascade)
}

model LlmProvider {
  id        String   @id @default(uuid())
  name      String
  provider  String
  model     String
  baseUrl   String
  apiKey    String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LlmSettings {
  id           String   @id
  systemPrompt String
  updatedAt    DateTime @updatedAt
}

model LlmSkill {
  id        String   @id
  name      String
  body      String
  enabled   Boolean  @default(true)
  builtin   Boolean  @default(false)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

model LandscapeState {
  id            String   @id
  name          String
  sourceStateId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  source        LandscapeState?  @relation("StateLineage", fields: [sourceStateId], references: [id], onDelete: SetNull)
  derived       LandscapeState[] @relation("StateLineage")
  applications       Application[]
  capabilities       Capability[]
  strategicGoals     StrategicGoal[]
  organizations      Organization[]
  informationObjects InformationObject[]
  integrations       Integration[]
  transformationsFrom Transformation[] @relation("TransformationFromState")
  transformationsTo   Transformation[] @relation("TransformationToState")
}

model Transformation {
  id          String               @id @default(uuid())
  name        String
  description String?
  status      String               @default("Planned")
  owner       String?
  startDate   DateTime?
  targetDate  DateTime?
  fromStateId String               @default("current")
  toStateId   String
  references  String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  fromState   LandscapeState       @relation("TransformationFromState", fields: [fromStateId], references: [id], onDelete: Cascade)
  toState     LandscapeState       @relation("TransformationToState", fields: [toStateId], references: [id], onDelete: Cascade)
  steps       TransformationStep[]

  @@index([fromStateId])
  @@index([toStateId])
}

model TransformationStep {
  id               String         @id @default(uuid())
  transformationId String
  entityType       String         @default("Application")
  action           String         @default("REPLACE")
  title            String?
  notes            String?
  predecessorIds   String         @default("[]")
  successorIds     String         @default("[]")
  order            Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  transformation   Transformation @relation(fields: [transformationId], references: [id], onDelete: Cascade)

  @@index([transformationId])
}

model WorkspaceSettings {
  id                   String   @id
  brandName            String
  disabledNativeFields String   @default("[]")
  updatedAt            DateTime @updatedAt
}

// Users, groups, and sessions are workspace-wide. They are not copied with a landscape state.
model User {
  id           String            @id @default(uuid())
  name         String
  email        String            @unique
  passwordHash String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  memberships  GroupMembership[]
  sessions     Session[]
}

model Group {
  id          String            @id @default(uuid())
  name        String            @unique
  builtIn     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships GroupMembership[]
  grants      GroupGrant[]
}

model GroupMembership {
  userId  String
  groupId String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}

// organizationId is a portfolio organization id with no foreign key. Copies in other
// landscape states get new ids, so a grant is matched by the organization's name path.
model GroupGrant {
  id             String  @id @default(uuid())
  groupId        String
  area           String
  level          String
  organizationId String?
  group          Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
